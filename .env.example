PORT=5000
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://www.travel-mate.site,https://travel-mate.site
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Optional; Prisma Migrate in this project uses DATABASE_URL.
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full
SESSION_SECRET=replace_with_at_least_32_random_characters
ACCOUNT_TOKEN_SECRET=replace_with_a_different_32_character_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
OAUTH_STATE_SECRET=replace_with_a_third_random_32_character_secret
EMAIL_PROVIDER=resend
# Development alternative without a domain: EMAIL_PROVIDER=gmail.
# Gmail connects with TLS to smtp.gmail.com:465; EMAIL_FROM must match SMTP_USER.
# Enable Google 2-Step Verification, then create an App Password (not your login password).
# Keep these values only in the backend .env. Gmail provider is disabled in production.
SMTP_USER=
SMTP_PASS=
# Supply a real Resend API key with Sending access for the verified sender domain.
# Blank values intentionally fail validation; never paste the key into frontend env files.
RESEND_API_KEY=
# Address on a domain you own whose sending DNS records are verified in Resend.
# Do not use resend.dev: its test sender is restricted and is not accepted for account verification.
# Format: TravelMate <noreply@YOUR_VERIFIED_DOMAIN> (replace with your real domain).
EMAIL_FROM=
# Used only by `npm run email:smoke`; never required by the running API.
EMAIL_SMOKE_TO=
AI_PROVIDER=openai
# Explicit local/demo fallback. Ignored in production; configured-provider failures never become mock plans.
AI_MOCK_FALLBACK=true
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OPENWEATHER_API_KEY=your_openweather_api_key_here
AMADEUS_ENV=test
AMADEUS_API_KEY=your_amadeus_api_key_here
AMADEUS_API_SECRET=your_amadeus_api_secret_here
# Worldwide nearby map listings (no room prices or availability). No key needed
# for the small-development default; use a hosted/private Overpass instance for
# production or higher traffic. Public default is capped at 100 searches/day.
ACCOMMODATION_PLACES_URL=https://overpass-api.de/api/interpreter
# Optional compatible secondary Overpass endpoint. The public default also
# retries overpass.kumi.systems after a provider failure.
ACCOMMODATION_PLACES_FALLBACK_URL=
# Explicit manual destination resolution only (never public autocomplete).
# No key needed for the development default; use a compatible hosted/private
# Nominatim service for production, especially across multiple app instances.
DESTINATION_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Optional separate Overpass interpreter for area towns and user-requested
# interest comparisons. Empty uses ACCOMMODATION_PLACES_URL or its public default.
DESTINATION_AREAS_PLACES_URL=
PAYMONGO_SECRET_KEY=your_paymongo_test_secret_here

# Optional complete accommodation catalog + date/occupancy-specific room quotes.
# Approved Expedia Rapid partner credentials; never NEXT_PUBLIC_ variables.
RAPID_API_KEY=
RAPID_API_SECRET=
# test is the default. production requires approved production access.
RAPID_ENV=test
# Point-of-sale country, not the destination country.
RAPID_POINT_OF_SALE_COUNTRY=PH
# Enable only after confirming your Rapid agreement permits this display.
RAPID_CONTENT_RIGHTS_CONFIRMED=false
# Supply the credit and terms URL required by your provider agreement.
RAPID_PHOTO_ATTRIBUTION_TEXT=
RAPID_PHOTO_TERMS_URL=
# Optional Cloud Translation Advanced romanizeText fallback, using backend ADC.
HOTEL_ROMANIZATION_PROJECT=
HOTEL_ROMANIZATION_LOCATION=global

# LiteAPI recommendation-only sandbox. Never place this key in NEXT_PUBLIC_*.
LITEAPI_API_KEY=
LITEAPI_ENV=sandbox
# Independent, strong secret (at least 32 characters) for opaque hotel selection tokens.
ACCOMMODATION_QUOTE_SECRET=

# Optional, server-only: paid Open-Meteo endpoint for trip-map commercial usage.
# Leave empty for evaluation/non-commercial public API use.
OPEN_METEO_API_KEY=

# Optional public contact URL/email for Wikimedia's API User-Agent (no API key).
# Example: TravelMate/1.0 (https://your-public-site.example; contact@example.com)
WIKIMEDIA_USER_AGENT=
# Shared photo-fallback request spacing across Wikimedia sites, in milliseconds.
# Default 6100 (conservative anonymous limit); minimum 1100. Reduce only for a
# compliant, identified bot whose applicable Wikimedia limits permit it.
WIKIMEDIA_PHOTO_INTERVAL_MS=6100

# Optional, server-only Google Places API (New) activity photo fallback.
# Enable Places API (New), attach billing, restrict the key to that API and the
# backend's outbound IP(s). Browser HTTP referrer restrictions cannot be used here.
# Never use NEXT_PUBLIC_* for this key. See docs/google-places-photos.md.
GOOGLE_PLACES_API_KEY=
# Opt in only after enabling the API and agreeing to Google's billing requirements.
GOOGLE_PLACES_PHOTOS_ENABLED=false
