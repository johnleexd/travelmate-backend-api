generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  traveler
  owner
  admin
}

enum ProfileStatus {
  unverified
  pending
  verified
  rejected
}

enum AccountStatus {
  active
  suspended
}

enum ListingCategory {
  stay
  activity
  food
  transport
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  confirmed
  change_requested
  cancel_requested
  cancelled
  completed
}

enum PaymentStatus {
  PAID_HELD
  Released
  FROZEN_HELD
  REFUNDED
}

enum ModerationKind {
  profile
  listing
  dispute
}

enum ModerationStatus {
  pending
  approved
  rejected
  resolved
}

model User {
  id            String        @id @default(uuid())
  name          String
  email         String        @unique
  role          Role
  emailVerified Boolean       @default(false) @map("email_verified")
  profileStatus ProfileStatus @default(unverified) @map("profile_status")
  trustScore    Int           @default(50) @map("trust_score")
  accountStatus AccountStatus @default(active) @map("account_status")
  passwordHash  String        @map("password_hash")
  passwordSalt  String        @map("password_salt")
  bio           String?
  phone         String?
  listings      Listing[]
  bookings      Booking[]
  trips         Trip[]
  auditEvents   AuditEvent[]

  @@index([accountStatus])
  @@map("users")
}

model Listing {
  id           String          @id @default(uuid())
  ownerId      String          @map("owner_id")
  name         String
  category     ListingCategory
  price        Decimal         @db.Decimal(12, 2)
  capacity     Int
  available    Int
  status       ListingStatus
  description  String          @default("")
  municipality String          @default("Cordova")
  address      String          @default("")
  amenities    Json            @default("[]")
  imageUrl     String?         @map("image_url")
  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([ownerId])
  @@index([status])
  @@index([municipality, category, status])
  @@map("listings")
}

model Booking {
  id            String        @id @default(uuid())
  travelerId    String        @map("traveler_id")
  listingId     String        @map("listing_id")
  amount        Decimal       @db.Decimal(12, 2)
  guests        Int
  nights        Int           @default(1)
  status        BookingStatus
  paymentStatus PaymentStatus @map("payment_status")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  traveler      User          @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  listing       Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([travelerId])
  @@index([listingId])
  @@index([paymentStatus])
  @@map("bookings")
}

model Moderation {
  id        String           @id @default(uuid())
  kind      ModerationKind
  subjectId String           @map("subject_id")
  title     String
  details   String
  status    ModerationStatus
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("moderation")
}

model Trip {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  destination String
  budget      Decimal  @db.Decimal(12, 2)
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  travelers   Int
  interests   Json     @default("[]")
  itinerary   Json
  weather     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trips")
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@map("audit_events")
}
