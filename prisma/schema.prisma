generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  traveler
  admin
}

enum ProfileStatus {
  unverified
  pending
  verified
  rejected
}

enum AccountStatus {
  active
  suspended
}

enum AccountTokenKind {
  email_verification
  password_reset
}

enum OAuthProvider {
  google
}

enum TripStatus {
  active
  archived
  completed
}

enum PartyType {
  solo
  couple
  family
  friends
}

enum ItineraryVersionKind {
  saved
  regenerated
  manual_edit
  duplicated
  restored
}

enum GenerationStatus {
  pending
  completed
  failed
}

enum AllowanceState {
  reserved
  processing
  succeeded
  failed
  reconciled
}

enum SubscriptionSource {
  verified_payment
  admin_demo
  paymongo_test
}

enum ListingCategory {
  stay
  activity
  food
  transport
}

enum ListingStatus {
  pending
  approved
  rejected
}

enum BookingStatus {
  pending
  confirmed
  declined
  change_requested
  cancel_requested
  cancelled
  completed
}

enum PaymentStatus {
  PENDING
  PAID_HELD
  Released
  FROZEN_HELD
  REFUNDED
}

enum ModerationKind {
  appeal
  report
  profile
  listing
  dispute
}

enum ModerationStatus {
  pending
  approved
  rejected
  resolved
}

enum FeedbackSentiment {
  not_analyzed
  positive
  neutral
  negative
}

enum FeedbackCategory {
  budget_accuracy
  weather_info
  ai_cohesion
  route_efficiency
}

model Feedback {
  id          String            @id @default(uuid())
  userId      String?           @map("user_id")
  itineraryId String?           @map("itinerary_id")
  rating      Int
  sentiment   FeedbackSentiment @default(not_analyzed)
  category    FeedbackCategory
  comment     String
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  itinerary   Trip?             @relation(fields: [itineraryId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc), id])
  @@index([rating, sentiment, createdAt(sort: Desc)])
  @@index([userId])
  @@index([itineraryId])
  @@unique([userId, itineraryId])
  @@map("feedback")
}

model User {
  id                   String                @id @default(uuid())
  name                 String
  email                String                @unique
  role                 Role
  emailVerified        Boolean               @default(false) @map("email_verified")
  profileStatus        ProfileStatus         @default(unverified) @map("profile_status")
  trustScore           Int                   @default(50) @map("trust_score")
  accountStatus        AccountStatus         @default(active) @map("account_status")
  passwordHash         String?               @map("password_hash")
  passwordSalt         String?               @map("password_salt")
  sessionVersion       Int                   @default(0) @map("session_version")
  avatarUrl            String?               @map("avatar_url")
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamptz(6)
  bio                  String?
  phone                String?
  feedback             Feedback[]
  listings             Listing[]
  bookings             Booking[]
  trips                Trip[]
  visitedPlaces        VisitedPlace[]
  itineraryGenerations ItineraryGeneration[]
  subscription         PlanSubscription?
  auditEvents          AuditEvent[]
  accountTokens        AccountToken[]
  oauthAccounts        OAuthAccount[]
  revokedSessions      RevokedSession[]
  notifications        Notification[]
  ownerDocuments       OwnerDocument[]
  reviews              Review[]

  @@index([accountStatus])
  @@map("users")
}

model RateLimitBucket {
  key     String   @id @db.VarChar(300)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(6)

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

model RevokedSession {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("revoked_sessions")
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("oauth_accounts")
}

model AccountToken {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  kind      AccountTokenKind
  tokenHash String           @unique @map("token_hash")
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([expiresAt])
  @@map("account_tokens")
}

model Listing {
  id           String               @id @default(uuid())
  ownerId      String               @map("owner_id")
  name         String
  category     ListingCategory
  price        Decimal              @db.Decimal(12, 2)
  capacity     Int
  available    Int
  status       ListingStatus
  description  String               @default("")
  municipality String               @default("Cordova")
  address      String               @default("")
  amenities    Json                 @default("[]")
  imageUrl     String?              @map("image_url")
  imageUrls    Json                 @default("[]") @map("image_urls")
  viewCount    Int                  @default(0) @map("view_count")
  owner        User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  blockedDates ListingBlockedDate[]
  promotions   Promotion[]
  reviews      Review[]

  @@index([ownerId])
  @@index([status])
  @@index([municipality, category, status])
  @@map("listings")
}

model Booking {
  id                String               @id @default(uuid())
  travelerId        String               @map("traveler_id")
  listingId         String               @map("listing_id")
  amount            Decimal              @db.Decimal(12, 2)
  guests            Int
  nights            Int                  @default(1)
  status            BookingStatus
  paymentStatus     PaymentStatus        @map("payment_status")
  checkIn           DateTime?            @map("check_in") @db.Date
  checkOut          DateTime?            @map("check_out") @db.Date
  notes             String               @default("")
  requestedCheckIn  DateTime?            @map("requested_check_in") @db.Date
  requestedCheckOut DateTime?            @map("requested_check_out") @db.Date
  requestedGuests   Int?                 @map("requested_guests")
  requestNote       String               @default("") @map("request_note")
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  traveler          User                 @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  listing           Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  review            Review?
  transactions      PaymentTransaction[]

  @@index([travelerId])
  @@index([listingId])
  @@index([paymentStatus])
  @@map("bookings")
}

model ListingBlockedDate {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  date      DateTime @db.Date
  reason    String   @default("")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, date])
  @@index([date])
  @@map("listing_blocked_dates")
}

model Promotion {
  id          String   @id @default(uuid())
  listingId   String   @map("listing_id")
  name        String
  discountPct Int      @map("discount_pct")
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date
  active      Boolean  @default(true)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, active, startDate, endDate])
  @@map("promotions")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique @map("booking_id")
  listingId  String   @map("listing_id")
  travelerId String   @map("traveler_id")
  rating     Int
  comment    String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  traveler   User     @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@map("reviews")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String
  href      String    @default("")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model PaymentTransaction {
  id        String   @id @default(uuid())
  bookingId String   @map("booking_id")
  kind      String
  status    String
  amount    Decimal  @db.Decimal(12, 2)
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("payment_transactions")
}

model OwnerDocument {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  type      String
  name      String
  fileUrl   String   @map("file_url")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status])
  @@map("owner_documents")
}

model Moderation {
  id        String           @id @default(uuid())
  kind      ModerationKind
  subjectId String           @map("subject_id")
  title     String
  details   String
  status    ModerationStatus
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@map("moderation")
}

model Trip {
  id                     String             @id @default(uuid())
  saveKey                String?            @map("save_key") @db.VarChar(100)
  saveRequestHash        String?            @map("save_request_hash") @db.VarChar(64)
  userId                 String             @map("user_id")
  destination            String
  destinationCity        String?            @map("destination_city")
  destinationRegion      String?            @map("destination_region")
  destinationCountry     String?            @map("destination_country")
  destinationCountryCode String?            @map("destination_country_code") @db.VarChar(2)
  latitude               Decimal?           @db.Decimal(9, 6)
  longitude              Decimal?           @db.Decimal(9, 6)
  budget                 Decimal            @db.Decimal(12, 2)
  currency               String             @default("PHP") @db.VarChar(3)
  startDate              DateTime           @map("start_date") @db.Date
  endDate                DateTime           @map("end_date") @db.Date
  travelers              Int
  partyType              PartyType          @default(solo) @map("party_type")
  interests              Json               @default("[]")
  itinerary              Json
  weather                Json?
  status                 TripStatus         @default(active)
  archivedAt             DateTime?          @map("archived_at") @db.Timestamptz(6)
  completedAt            DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback               Feedback[]
  versions               ItineraryVersion[]
  visitedPlaces          VisitedPlace[]

  @@unique([userId, saveKey])
  @@index([userId])
  @@index([userId, status])
  @@map("trips")
}

model VisitedPlace {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  tripId      String?  @map("trip_id")
  placeKey    String   @map("place_key") @db.VarChar(100)
  name        String   @db.VarChar(160)
  destination String   @db.VarChar(120)
  visitDate   DateTime @map("visit_date") @db.Date
  latitude    Float?
  longitude   Float?
  place       Json?
  imageUrl    String?  @map("image_url") @db.VarChar(1000)
  imageAttribution Json? @map("image_attribution")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip        Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@unique([userId, placeKey, visitDate])
  @@index([userId, visitDate(sort: Desc), id])
  @@map("visited_places")
}

model ItineraryVersion {
  id        String               @id @default(uuid())
  tripId    String               @map("trip_id")
  version   Int
  kind      ItineraryVersionKind
  itinerary Json
  weather   Json?
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  trip      Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, version])
  @@index([tripId, createdAt(sort: Desc)])
  @@map("itinerary_versions")
}

model ItineraryGeneration {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  idempotencyKey String           @map("idempotency_key") @db.VarChar(100)
  requestHash    String           @map("request_hash") @db.VarChar(64)
  destination    String           @db.VarChar(120)
  status         GenerationStatus @default(pending)
  response       Json?
  errorCode      String?          @map("error_code") @db.VarChar(80)
  attemptId      String           @default(uuid()) @map("attempt_id")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowancePeriod DateTime?       @map("allowance_period") @db.Timestamptz(6)
  allowanceState  AllowanceState? @map("allowance_state")
  reservedUntil   DateTime?       @map("reserved_until") @db.Timestamptz(6)
  charged         Boolean        @default(false)
  operationKind   String         @default("itinerary") @map("operation_kind") @db.VarChar(30)
  relatedTripId   String?        @map("related_trip_id")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, allowancePeriod, allowanceState])
  @@map("itinerary_generations")
}

model PlanSubscription {
  userId        String             @id @map("user_id")
  source        SubscriptionSource
  activationKey String             @unique @map("activation_key") @db.VarChar(100)
  actorId       String?            @map("actor_id")
  reason        String?
  startsAt      DateTime           @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("plan_subscriptions")
}

model GenerationTracking {
  id        String   @id
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(6)

  @@map("generation_tracking")
}

model PlanCheckoutOrder {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(100)
  status          String   @default("creating") @db.VarChar(20)
  amount          Int
  currency        String   @default("PHP") @db.VarChar(3)
  durationDays    Int      @map("duration_days")
  sessionId       String?  @unique @map("session_id")
  paymentIntentId String?  @unique @map("payment_intent_id")
  paymentId       String?  @unique @map("payment_id")
  checkoutUrl     String?  @map("checkout_url")
  lastError       String?  @map("last_error") @db.VarChar(80)
  fulfilledAt     DateTime? @map("fulfilled_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@map("plan_checkout_orders")
}

model PlanActivation {
  key       String   @id @db.VarChar(100)
  userId    String   @map("user_id")
  actorId   String   @map("actor_id")
  reason    String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("plan_activations")
}

model AuditEvent {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  targetId  String   @map("target_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@map("audit_events")
}
